# Loaded only in development mode (`npm run dev:local`), never by `npm run build`,
# so a production bundle can't pick these up by accident.
# Disable the production userscript while testing: both match geoguessr.com and
# fight over the same note window in the DOM (cached lookups are namespaced, the
# rendered elements are not).
VITE_GEOMETA_API_URL=http://localhost:3000
VITE_GEOMETA_SITE_URL=http://localhost:5173
