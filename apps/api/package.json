{
  "name": "api",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target bun --minify-whitespace --minify-syntax --production --outdir dist --sourcemap",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "bun run src/scripts/migrate.ts",
    "test": "NODE_ENV=test API_INTERNAL_AUTH_REQUIRED=false bun test --preload ./tests/support/db-preload.ts --max-concurrency 1 --timeout 30000",
    "test:unit": "NODE_ENV=test API_INTERNAL_AUTH_REQUIRED=false bun test .unit.test.ts --concurrent --max-concurrency 20 --timeout 5000",
    "test:db": "NODE_ENV=test API_INTERNAL_AUTH_REQUIRED=false bun test .db.test.ts --preload ./tests/support/db-preload.ts --max-concurrency 1 --timeout 30000",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "fix": "biome check --write .",
    "type-check": "tsc --noEmit; rm tsconfig.tsbuildinfo",
    "sanity": "bun run format && bun run fix && bun run type-check"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/server-timing": "^1.4.1",
    "@sentry/bun": "^10.69.0",
    "async-retry": "^1.3.3",
    "aws4fetch": "^1.0.20",
    "cmd-ts": "^0.15.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "jose": "^6.1.3",
    "memoize-one": "^6.0.0",
    "postgres": "^3.4.9",
    "rehype-external-links": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remeda": "^2.39.0",
    "sharp": "^0.35.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/async-retry": "^1.4.9",
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  }
}
