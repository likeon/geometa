    "start": "node --env-file-if-exists=.env dist/bot.js"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
